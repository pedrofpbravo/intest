rules_version = '2';

// Two personal accounts, per-user private data: each signed-in user can
// only read and write their own users/{uid} subtree. Also disable sign-up
// in the Firebase console (Authentication > Settings > User actions >
// "Enable create (sign-up)" off) so no one can create accounts with the
// public web key.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
